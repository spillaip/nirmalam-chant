<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".NirmalamApplication"
        android:allowBackup="false"
        android:icon="@drawable/nirmalam_launcher_512"
        android:label="Nirmalam Chant"
        android:theme="@style/Theme.Nirmalam">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".reminders.LocalReminderReceiver" android:exported="false" />
    </application>
</manifest>
